rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validRoom(roomId) {
      return roomId.matches('[a-z0-9]{6,24}');
    }

    function validUser(d) {
      return d.keys().hasOnly(['nickname', 'picks', 'joinedAt'])
        && d.keys().hasAll(['nickname', 'picks', 'joinedAt'])
        && d.nickname is string
        && d.nickname.size() > 0
        && d.nickname.size() <= 20
        && d.picks is map
        && d.picks.size() <= 20
        && d.joinedAt is number;
    }

    // rooms/{방번호}/users/{기기 uid}
    match /rooms/{roomId}/users/{uid} {
      // 로그인(익명 포함)한 사람만, 방 링크를 아는 경우에만 읽기
      allow read: if request.auth != null && validRoom(roomId);

      // 내 uid 문서에만, 정해진 형식으로만 쓰기
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && validRoom(roomId)
                            && validUser(request.resource.data);

      allow delete: if false;
    }

    // 위에 명시되지 않은 모든 경로는 기본적으로 접근 차단
  }
}
